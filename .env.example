# ============================================================
# tiktok-threads-engine configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Telegram (required) -----------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
*** Your numeric Telegram user ID (ask @userinfobot). Bot ignores everyone else.
TELEGRAM_ALLOWED_USER_ID=

# --- LLM (required) ----------------------------------------
# Any OpenAI-compatible endpoint works: OpenRouter, OpenAI, local Qwen, etc.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_M…hat
# Set to "mock" to run the full pipeline offline with canned outputs (dev only)
# LLM_PROVIDER=mock

# --- Threads / Meta (required for real publishing) ---------
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_R…i/v1
# Filled automatically by:  python -m scripts.threads_login
THREADS_ACCESS_TOKEN=
# Filled automatically by:  python -m scripts.threads_login
THREADS_USER_ID=
THREADS_API_VERSION=v21.0

# --- TikTok (optional, off by default) ----------------------
# Only if you have TikTok Shop API access. Without it, the public
# metadata resolver is used automatically.
TIKTOK_API_ENABLED=false
TIKTOK_API_BASE_URL=https://open-api.tiktok.com
TIKTOK_API_ACCESS_TOKEN=

*** --- Trend providers (optional) ------------------------------
# RSS feeds are used by default (no key needed).
# A search API key enables the web-discussion provider.
SEARCH_API_PROVIDER=
SEARCH_API_KEY=
GOOGLE_TRENDS_ENABLED=false

# --- Behaviour -----------------------------------------------
# Master switch for real publishing. Keep false until you trust the output.
AUTO_PUBLISH=false
# DRY_RUN=true: everything runs, but nothing is actually published.
DRY_RUN=true
TZ=Asia/Kuala_Lumpur

# Smart auto queue
OPPORTUNITY_THRESHOLD=75
SMART_MAX_WAIT_HOURS=24
TREND_REFRESH_MINUTES=20
OPPORTUNITY_SCAN_MINUTES=10

# Posting rate / anti-spam
MAX_POSTS_PER_DAY=4
MIN_HOURS_BETWEEN_POSTS=6
QUIET_HOURS=23:00-08:00
MAX_SIMILAR_PRODUCTS_PER_DAY=2
SIMILARITY_THRESHOLD=0.62

# Analytics checkpoints (hours after publish)
ANALYTICS_CHECKPOINTS=1,6,24,72

# Content
AFFILIATE_DISCLOSURE_ENABLED=true
AFFILIATE_DISCLOSURE_TEXT=affiliate link
CONTENT_LANGUAGE=rojak
# evergreen | auto  (auto = trend if strong enough, evergreen otherwise)
CONTENT_STRATEGY=auto

# Telegram notification verbosity: minimal | normal | verbose
NOTIFY_LEVEL=normal

# --- Admin/debug API (localhost only) ------------------------
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8321
ADMIN_TOKEN=
